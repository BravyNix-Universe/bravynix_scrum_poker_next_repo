# Copy to .env.local. These are read at build time (npm run dev / npm run build).

# Leave empty for live, peer-to-peer rooms. "preview" runs rooms in one tab with simulated teammates.
NEXT_PUBLIC_ROOM_MODE=

# PeerJS connection service. Leave NEXT_PUBLIC_PEER_HOST empty to use the free PeerJS cloud.
# For a local PeerServer (npx peer --port 9000): localhost, 9000, /, false.
NEXT_PUBLIC_PEER_HOST=
NEXT_PUBLIC_PEER_PORT=
NEXT_PUBLIC_PEER_PATH=
NEXT_PUBLIC_PEER_SECURE=
